[Unit]
Description=Eniboard API
After=network.target

[Service]
Type=simple
User=eniboard
Group=eniboard
WorkingDirectory=/opt/eniboard/api
ExecStart=/usr/bin/dotnet /opt/eniboard/api/Api.dll
EnvironmentFile=/opt/eniboard/eniboard-api.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5060
Restart=on-failure
RestartSec=5
SyslogIdentifier=eniboard-api

[Install]
WantedBy=multi-user.target
